@page
@model WebHostRazor.Pages.Host.Tenants.CreateModel

@{
    ViewData["Title"] = "Create Tenant";
}

<div class="tenant-card">

    <div class="tenant-header">
        <div class="tenant-header-icon">👤</div>
        <div>
            <div class="tenant-title">Tenant Information</div>
            <div class="tenant-sub">Fields with * are required</div>
        </div>
    </div>

    <form method="post" id="createForm">
        @Html.AntiForgeryToken()

        <div class="tenant-body">

            <!-- CUSTOMER -->
            <div class="section">
                <div class="section-title">Customer</div>

                <div class="grid-2">

                    <div class="form-group col-2">
                        <label>Select Customer *</label>
                        <select asp-for="Input.UserId"
                                asp-items="Model.Customers"
                                id="customerSelect">
                            <option value="">Select customer...</option>
                        </select>
                    </div>

                </div>
            </div>

            <!-- PERSONAL -->
            <div class="section">
                <div class="section-title">Personal</div>

                <div class="grid-3">

                    <div class="form-group">
                        <label>Gender</label>
                        <select asp-for="Input.Gender">
                            <option value="">Select...</option>
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>
                        <input asp-for="Input.DateOfBirth" type="date" />
                    </div>

                    <div class="form-group">
                        <label>CCCD</label>
                        <div class="input-icon">
                            <span>🪪</span>
                            <input asp-for="Input.CCCD" />
                        </div>
                    </div>

                </div>
            </div>

            <!-- CONTACT -->
            <div class="section">
                <div class="section-title">Contact</div>

                <div class="grid-2">

                    <div class="form-group">
                        <label>Phone</label>
                        <div class="input-icon">
                            <span>📞</span>
                            <input id="phoneField" readonly />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-icon">
                            <span>✉️</span>
                            <input id="emailField" readonly />
                        </div>
                    </div>

                    <div class="form-group col-2">
                        <label>Address</label>
                        <div class="input-icon">
                            <span>📍</span>
                            <input asp-for="Input.Address" />
                        </div>
                    </div>

                </div>
            </div>

            <!-- LEASE -->
            <div class="section">
                <div class="section-title">Lease Details</div>

                <div class="grid-2">

                    <div class="form-group">
                        <label>Status *</label>

                        <div class="status-group">
                            <label class="status-pill">
                                <input type="radio"
                                       asp-for="Input.Status"
                                       value="Active" checked />
                                <span>Active</span>
                            </label>

                            <label class="status-pill">
                                <input type="radio"
                                       asp-for="Input.Status"
                                       value="Disabled" />
                                <span>Disabled</span>
                            </label>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="tenant-footer">
            <a asp-page="Index" class="btn-light">Cancel</a>
            <button type="submit" class="btn-primary" id="submitBtn">
                Create Tenant
            </button>
        </div>

    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@section Scripts {

    <script>

        const customerSelect = document.getElementById("customerSelect");
        const emailField = document.getElementById("emailField");
        const phoneField = document.getElementById("phoneField");

        customerSelect.addEventListener("change", async function(){

            const userId = this.value;

            if(!userId){
                emailField.value = "";
                phoneField.value = "";
                return;
            }

            const response = await fetch(`?handler=CustomerInfo&userId=${userId}`);
            const data = await response.json();

            emailField.value = data.email ?? "";
            phoneField.value = data.phone ?? "";
        });

        const form = document.getElementById("createForm");
        const submitBtn = document.getElementById("submitBtn");

        form.addEventListener("submit", async function (e) {

            e.preventDefault();

            submitBtn.disabled = true;
            submitBtn.innerText = "Processing...";

            const formData = new FormData(form);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {

                const response = await fetch("", {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": token
                    },
                    body: formData
                });

                const result = await response.json();

                if (result.success) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: result.message
                    }).then(() => {
                        window.location.href = "Index";
                    });

                } else {

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: result.message
                    });

                }

            }
            catch {

                Swal.fire({
                    icon: 'error',
                    title: 'Server Error',
                    text: 'Something went wrong!'
                });

            }
            finally {

                submitBtn.disabled = false;
                submitBtn.innerText = "Create Tenant";

            }

        });

    </script>

}