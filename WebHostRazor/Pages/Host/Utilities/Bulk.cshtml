@page "/Host/Utilities"
@model WebHostRazor.Pages.Host.Utilities.BulkModel
@{
    ViewData["Title"] = "Utilities";
}

<div class="tenant-page">

    <!-- HEADER -->
    <div class="tp-header">

        <div>
            <div class="tp-badge">Utilities</div>
            <h1 class="tp-title">Electricity & Water</h1>
            <div class="tp-sub">
                Enter monthly electricity and water readings for all rooms.
            </div>
        </div>

    </div>

    <!-- PERIOD SELECT -->
    <div class="tp-table-card" style="margin-bottom:15px;">

        <form method="get" class="tp-toolbar">

            <div>
                <label style="font-size:13px;">Period (YYYYMM)</label>
                <input name="period"
                       value="@Model.Dto.Period"
                       class="tp-search"
                       style="width:150px;" />
            </div>

            <button type="submit" class="tp-add-btn">
                Load
            </button>

            <div class="tp-total">
                @Model.Dto.Items.Count rooms
            </div>

        </form>

    </div>

    <!-- SUCCESS -->
    @if (TempData["success"] != null)
    {
        <div style="color:green; margin-bottom:10px;">
            @TempData["success"]
        </div>
    }

    <!-- TABLE -->
    <div class="tp-table-card">

        <form method="post">
            <input type="hidden" asp-for="Dto.Period" />

            <table class="tp-table">
                <thead>
                    <tr>
                        <th>Room</th>
                        <th>Electric (kWh)</th>
                        <th>Water (m³)</th>
                    </tr>
                </thead>

                <tbody>

                    @for (int i = 0; i < Model.Dto.Items.Count; i++)
                    {
                        <tr>
                            <td>
                                <div class="tp-tenant-cell">
                                    <div class="tp-avatar">
                                        @Model.Rooms[i].RoomCode.Substring(0, 1)
                                    </div>

                                    <div class="tp-name">
                                        @Model.Rooms[i].RoomCode
                                    </div>
                                </div>

                                <input type="hidden" asp-for="Dto.Items[i].RoomId" />
                            </td>

                            <td>
                                <input asp-for="Dto.Items[i].ElectricKwh"
                                       type="number"
                                       min="0"
                                       class="form-control" />
                            </td>

                            <td>
                                <input asp-for="Dto.Items[i].WaterM3"
                                       type="number"
                                       min="0"
                                       class="form-control" />
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

            <div style="margin-top:15px; text-align:right;">
                <button class="tp-add-btn">
                    💾 Save Readings
                </button>
            </div>

        </form>

    </div>

</div>