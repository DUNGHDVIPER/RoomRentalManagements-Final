@page
@model WebHostRazor.Pages.Host.Notifications.HistoryModel
@using DAL.Entities.System
@using DAL.Entities.Common
@{
    ViewData["Title"] = "Histories";
}

<div class="card shadow-lg p-4">
    <h3 class="mb-4">📜Histories</h3>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Name</th>
                <th>Content</th>
                <th>Type</th>
                <th>Create At</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Notifications)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>
                        @item.Contract?.Tenant?.FullName
                    </td>
                    <td>@item.Content</td>
                    <td>@item.SourceType</td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (item.IsRead)
                        {
                            <span class="badge bg-success">Read</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Not Yet</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>