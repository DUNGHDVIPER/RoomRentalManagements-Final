@model WebAdmin.MVC.Models.Rooms.RoomDetailsVm

<div class="container">

    
    <div class="card">

        <!-- HEADER -->

        <div class="card-head">
            <div class="card-title">Room Details</div>
        </div>

        <!-- ROOM INFO -->

        <div class="card-body">

            <p><b>Room Code:</b> @Model.RoomCode</p>
            <p><b>Room Name:</b> @Model.RoomName</p>
            <p><b>Block:</b> @Model.Block</p>
            <p><b>Floor:</b> @Model.Floor</p>

            <p>
                <b>Status:</b>

                @if (Model.Status == "Available")
                {
                    <span class="room-status status-available">Available</span>
                }
                else if (Model.Status == "Occupied")
                {
                    <span class="room-status status-occupied">Occupied</span>
                }
                else
                {
                    <span class="room-status status-maintenance">Maintenance</span>
                }

            </p>

            <p><b>Price:</b> @Model.Price.ToString("N0")</p>

        </div>

        <!-- ROOM IMAGES -->

        <div class="card-head">
            <div class="card-title">Room Images</div>
        </div>

        <div class="card-body">

            @if (Model.Images != null && Model.Images.Any())
            {

                <div class="row">

                    @foreach (var img in Model.Images)
                    {

                        <div>
                            <img src="@img.ImageUrl" />
                        </div>

                    }

                </div>

            }
            else
            {
                <p>No images available.</p>
            }

        </div>

        <!-- BACK BUTTON -->

        <div class="card-body">

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>
   
</div>
