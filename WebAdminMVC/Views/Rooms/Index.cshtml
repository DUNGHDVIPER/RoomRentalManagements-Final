@model List<WebAdmin.MVC.Models.Rooms.RoomListItemVm>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Rooms";

    string currentSearch = Context.Request.Query["search"];
    string currentStatus = Context.Request.Query["status"];
}

<div class="container">

    <div class="card">

        <div class="card-head">

            <h2>Rooms</h2>

            <a asp-action="Create"
               class="btn btn-primary">

                + Create Room

            </a>

        </div>


        <!-- SEARCH + FILTER -->

        <form method="get" class="toolbar">

            <input type="text"
                   name="search"
                   value="@currentSearch"
                   placeholder="Search room..." />

            <select name="status">

                <option value="">All Status</option>

                <option value="Available"
                        selected="@(currentStatus == "Available")">
                    Available
                </option>

                <option value="Occupied"
                        selected="@(currentStatus == "Occupied")">
                    Occupied
                </option>

                <option value="Maintenance"
                        selected="@(currentStatus == "Maintenance")">
                    Maintenance
                </option>

            </select>

            <button type="submit" class="btn btn-secondary">
                Search
            </button>

        </form>


        <!-- TABLE -->

        <table class="table">

            <thead>

                <tr>

                    <th>Room</th>
                    <th>Block</th>
                    <th>Floor</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th style="width:200px">Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var r in Model)
                {

                    <tr>

                        <td>@r.Name</td>

                        <td>@r.Block</td>

                        <td>@r.Floor</td>

                        <td>@r.Price.ToString("N0")</td>

                        <td>@r.Status</td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@r.Id"
                               class="btn btn-sm btn-info">

                                Details

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@r.Id"
                               class="btn btn-sm btn-warning">

                                Edit

                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@r.Id"
                                  method="post"
                                  style="display:inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete room @r.Name ?')">

                                    Delete

                                </button>

                            </form>

                        </td>

                    </tr>

                }

            </tbody>

        </table>


        <!-- PAGINATION -->

        <div class="pagination">

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {

                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-search="@currentSearch"
                   asp-route-status="@currentStatus"
                   class="page-link @(i == ViewBag.Page ? "active" : "")">

                    @i

                </a>

            }

        </div>

    </div>

</div>
