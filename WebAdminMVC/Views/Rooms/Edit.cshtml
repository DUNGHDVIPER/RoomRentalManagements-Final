@model WebAdmin.MVC.Models.Rooms.RoomEditVm

@{
	ViewData["Title"] = "Edit Room";
}

<div class="container mt-4">

	<div class="form-card">

		<div class="form-title">Edit Room</div>

		<form asp-action="Edit"
			  method="post"
			  enctype="multipart/form-data">

			<input type="hidden" asp-for="Id" />

			<div asp-validation-summary="All"></div>

			<div class="form-grid">

				<div class="form-group">
					<label asp-for="RoomCode"></label>
					<input asp-for="RoomCode" />
				</div>

				<div class="form-group">
					<label asp-for="RoomName"></label>
					<input asp-for="RoomName" />
				</div>

				<div class="form-group">
					<label asp-for="AreaM2"></label>
					<input asp-for="AreaM2" />
				</div>

				<div class="form-group">
					<label asp-for="MaxOccupants"></label>
					<input asp-for="MaxOccupants" />
				</div>

				<div class="form-group">
					<label asp-for="CurrentBasePrice"></label>
					<input asp-for="CurrentBasePrice" />
				</div>

				<div class="form-group">
					<label asp-for="Status"></label>
					<select asp-for="Status">
						<option value="Available">Available</option>
						<option value="Occupied">Occupied</option>
						<option value="Maintenance">Maintenance</option>
					</select>
				</div>

				<div class="form-group full">
					<label asp-for="Description"></label>
<textarea asp-for="Description"></textarea>
				</div>

				<div class="form-group full">

					<label>Upload New Images</label>

					<input type="file"
						   name="NewImages"
						   multiple
						   accept="image/*" />

				</div>

			</div>

			<div class="btn-row">

				<button type="submit"
						class="btn-primary">

					Update Room

				</button>

				<a asp-action="Index"
				   class="btn-secondary">

					Back

				</a>

			</div>

		</form>

	</div>

</div>
