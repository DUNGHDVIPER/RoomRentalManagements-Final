@model BLL.DTOs.Property.BlockDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Block";
}

<div class="container">

    <div class="card pad-20">

        <div class="card-head">
            <div class="card-title">Create Block</div>
            <a class="link" asp-action="Index">Back</a>
        </div>

        <form asp-action="Create" method="post" class="form-grid">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="err"></div>

            <div class="fg">
                <label asp-for="BlockName" class="lbl"></label>
                <input class="inp" asp-for="BlockName" />
                <span asp-validation-for="BlockName" class="err"></span>
            </div>

            <div class="fg">
                <label asp-for="Address" class="lbl"></label>
                <input class="inp" asp-for="Address" />
                <span asp-validation-for="Address" class="err"></span>
            </div>

            <div class="fg">
                <label asp-for="Note" class="lbl"></label>
                <input class="inp" asp-for="Note" />
                <span asp-validation-for="Note" class="err"></span>
            </div>

            <div class="form-actions">

                <button class="btn-gradient" type="submit">
                    Create
                </button>

                <a class="btn" asp-action="Index">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}