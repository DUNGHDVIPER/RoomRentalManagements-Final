@model BLL.DTOs.Room.AmenityDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Amenity";
}

<div class="container">

    <div class="card">

        <div class="card-head">
            <div class="card-title">Edit Amenity</div>
        </div>

        <form asp-action="Edit" method="post" class="form-grid">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="AmenityId" />

            @if (TempData["Error"] != null)
            {
                <div class="err">
                    @TempData["Error"]
                </div>
            }

            <div class="fg">

                <label asp-for="AmenityName" class="lbl"></label>

                <input asp-for="AmenityName"
                       class="inp"
                       placeholder="Enter amenity name..." />

                <span asp-validation-for="AmenityName"
                      class="err"></span>

            </div>

            <div class="form-actions">

                <button class="btn-gradient">
                    Update
                </button>

                <a asp-action="Index"
                   class="btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
