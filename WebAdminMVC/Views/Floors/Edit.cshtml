@model BLL.DTOs.Property.FloorDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Floor";
}

<div class="container">

    <div class="card">

        <div class="card-head">
            <div class="card-title">Edit Floor</div>
        </div>

        <form asp-action="Edit" method="post" class="form-grid">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="err"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BlockId" />

            <div class="fg">
                <label class="lbl">Block</label>
                <input class="inp" value="@Model.BlockName" readonly />
            </div>

            <div class="fg">
                <label asp-for="FloorName" class="lbl"></label>
                <input asp-for="FloorName" class="inp" />
                <span asp-validation-for="FloorName" class="err"></span>
            </div>

            <div class="form-actions">

                <button class="btn-gradient">
                    Update
                </button>

                <a asp-action="Index"
                   asp-route-blockId="@Model.BlockId"
                   class="btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}