@model List<BLL.DTOs.Property.FloorListVm>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Floors";
}

<div class="container">

    <div class="card">

        <div class="card-head">
            <div class="card-title">
                Floors - Block @ViewBag.BlockName

            </div>

            <a asp-action="Create"
               asp-route-blockId="@ViewBag.BlockId"
               class="btn-gradient">
                + Create Floor
            </a>
        </div>

        <div class="table-wrap">

            <table class="table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>FLOOR NAME</th>
                        <th>TOTAL ROOMS</th>
                        <th class="th-right">ACTIONS</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var floor in Model)
                    {
                        <tr>

                            <td>@floor.Id</td>

                            <td class="user-email">
                                @floor.FloorName
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    @floor.TotalRooms Rooms
                                </span>
                            </td>

                            <td class="td-right">

                                <a asp-action="Details"
                                   asp-route-id="@floor.Id"
                                   class="link">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@floor.Id"
                                   class="link">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      method="post"
                                      style="display:inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@floor.Id" />
                                    <input type="hidden" name="blockId" value="@ViewBag.BlockId" />

                                    <button class="link danger"
                                            onclick="return confirm('Delete this floor?')">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
