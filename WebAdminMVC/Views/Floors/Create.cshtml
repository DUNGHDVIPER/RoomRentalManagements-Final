@model BLL.DTOs.Property.FloorDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Floor";
}

<div class="container">

    <div class="card">

        <div class="card-head">
            <div class="card-title">Create Floor</div>
        </div>

        <form asp-action="Create" method="post" class="form-grid">

            @Html.AntiForgeryToken()

            <!-- HIỂN THỊ LỖI MODEL -->
            <div asp-validation-summary="All" class="err"></div>

            <!-- BlockId gửi về server -->
            <input type="hidden" asp-for="BlockId" />

            <!-- Block name chỉ hiển thị -->
            <div class="fg">
                <label class="lbl">Block</label>
                <input class="inp" value="@Model.BlockName" readonly />
            </div>

            <!-- Floor name -->
            <div class="fg">
                <label asp-for="FloorName" class="lbl"></label>
                <input asp-for="FloorName" class="inp" />
                <span asp-validation-for="FloorName" class="err"></span>
            </div>

            <!-- BUTTON -->
            <div class="form-actions">

                <button type="submit" class="btn-gradient">
                    Create
                </button>

                <a asp-action="Index"
                   asp-route-blockId="@Model.BlockId"
                   class="btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}