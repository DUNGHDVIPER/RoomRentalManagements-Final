@model BLL.DTOs.Property.FloorDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Floor Details";
}

<div class="container">

    <div class="card">

        <div class="card-head">

            <div class="card-title">
                Floor Details
            </div>

            <div>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="link">
                    Edit
                </a>

                <form asp-action="Delete"
                      method="post"
                      style="display:inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="blockId" value="@Model.BlockId" />

                    <button class="link danger"
                            onclick="return confirm('Delete this floor?')">
                        Delete
                    </button>

                </form>

            </div>

        </div>

        <div style="padding:22px">

            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px">

                <div>
                    <div class="profile-role">Block</div>
                    <div class="profile-name">@Model.BlockName</div>
                </div>

                <div>
                    <div class="profile-role">Floor Id</div>
                    <div class="profile-name">@Model.Id</div>
                </div>

                <div>
                    <div class="profile-role">Floor Name</div>
                    <div class="profile-name">@Model.FloorName</div>
                </div>

                <div>
                    <div class="profile-role">Total Rooms</div>
                    <div>
                        <span class="badge bg-success">
                            @Model.TotalRooms Rooms
                        </span>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>