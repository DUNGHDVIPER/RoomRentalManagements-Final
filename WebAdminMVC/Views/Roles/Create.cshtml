@model WebAdminMVC.Models.Roles.RoleCreateVm
@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Role";
}

<style>
    /* Enhanced form card styling */
    .ui-card.form-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow);
        max-width: 600px;
        margin: 0 auto;
        overflow: hidden;
    }

    /* Enhanced toolbar styling */
    .toolbar {
        background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
        padding: 24px 28px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .toolbar h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .toolbar h1::before {
                content: "✨";
                font-size: 1.5rem;
            }

    .muted {
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
        margin-top: 4px;
    }

    /* Form content styling */
    .form-content {
        padding: 32px 28px;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .label {
        display: block;
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 8px;
        position: relative;
    }

        .label::after {
            content: " *";
            color: var(--red);
            font-weight: 500;
        }

    .input {
        width: 100%;
        height: 48px;
        border-radius: var(--radius-lg);
        border: 2px solid var(--border);
        padding: 0 16px;
        background: #fff;
        font-size: 15px;
        font-weight: 500;
        transition: all 0.2s ease;
        outline: none;
    }

        .input:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
            transform: translateY(-1px);
        }

        .input::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

    /* Validation styling */
    .text-danger {
        color: var(--red);
        font-size: 13px;
        font-weight: 600;
        margin-top: 6px;
        display: block;
    }

    .input.input-validation-error {
        border-color: var(--red);
        background-color: #fef2f2;
    }

    /* Action buttons section */
    .action-section {
        padding: 24px 28px;
        border-top: 1px solid var(--border);
        background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
    }

    /* Form buttons */
    .form-buttons {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: var(--radius-lg);
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        min-width: 120px;
        justify-content: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--blue) 0%, #1d4ed8 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.4);
            color: white;
            text-decoration: none;
        }

    .btn-ghost {
        background: transparent;
        color: var(--muted);
        border: 2px solid var(--border);
    }

        .btn-ghost:hover {
            background: #f8fafc;
            color: var(--text);
            border-color: #cbd5e1;
            transform: translateY(-1px);
            text-decoration: none;
        }

    /* Alert styling */
    .validation-summary {
        background: linear-gradient(135deg, #fee2e2 0%, #fca5a5 100%);
        color: #7f1d1d;
        border: 1px solid #f87171;
        padding: 16px 20px;
        border-radius: var(--radius-lg);
        margin-bottom: 24px;
        font-weight: 600;
    }

        .validation-summary ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .validation-summary li {
            margin-bottom: 4px;
        }

            .validation-summary li::before {
                content: "⚠️ ";
                margin-right: 8px;
            }

    /* Responsive design */
    @@media (max-width: 768px) {
        .ui-card.form-card

    {
        margin: 0 16px;
    }

    .toolbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding: 20px 24px;
    }

    .form-content {
        padding: 24px 20px;
    }

    .action-section {
        padding: 20px 20px;
    }

    .form-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .btn {
        width: 100%;
    }

    }

    /* Loading animation for submit button */
    .btn-primary:active {
        transform: scale(0.98);
    }

    /* Focus visible for accessibility */
    .btn:focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 2px;
    }
</style>

<div class="container">
    <div class="ui-card form-card">
        <!-- Header Section -->
        <div class="toolbar">
            <div>
                <h1>Create New Role</h1>
                <div class="muted">Add a new role to the system</div>
            </div>
        </div>

        <!-- Form Content -->
        <div class="form-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                }

                <div class="form-group">
                    <label class="label" for="Name">@Html.DisplayNameFor(m => m.Name)</label>
                    <input class="input @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "input-validation-error" : "")"
                           asp-for="Name"
                           placeholder="e.g. Manager, Supervisor, Moderator"
                           autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Form Action Buttons -->
                <div class="action-section">
                    <div class="form-buttons">
                        <a class="btn btn-ghost" asp-action="Index">
                            <i class="fas fa-times"></i>
                            Cancel
                        </a>
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-plus"></i>
                            Create Role
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Enhanced form interactions
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const submitBtn = document.querySelector('.btn-primary');
            const nameInput = document.querySelector('#Name');

            // Auto-focus on name input
            if (nameInput) {
                nameInput.focus();
            }

            // Form submission loading state
            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating...';
                    submitBtn.disabled = true;
                });
            }

            // Real-time validation feedback
            if (nameInput) {
                nameInput.addEventListener('input', function() {
                    const value = this.value.trim();
                    const errorSpan = this.nextElementSibling;

                    if (value.length === 0) {
                        this.classList.add('input-validation-error');
                        errorSpan.textContent = 'Role name is required';
                    } else if (value.length > 50) {
                        this.classList.add('input-validation-error');
                        errorSpan.textContent = 'Role name cannot exceed 50 characters';
                    } else {
                        this.classList.remove('input-validation-error');
                        errorSpan.textContent = '';
                    }
                });
            }
        });
    </script>
}