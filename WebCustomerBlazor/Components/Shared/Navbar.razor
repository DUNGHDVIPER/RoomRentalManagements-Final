@using Microsoft.AspNetCore.Components.Authorization
@inject ICookieService CookieService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<header class="header glass">
    <div class="container">
        <div class="header-inner">
            <div class="header-logo">
                <a href="/" class="logo">
                    <span class="logo-text">RoomRental</span>
                </a>
            </div>

            <nav class="nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <a href="/" class="nav-link @(IsActive("/") ? "active" : "")">Home</a>
                    </li>
                    <li class="nav-item">
                        <a href="/rooms" class="nav-link @(IsActive("/rooms") ? "active" : "")">Rooms</a>
                    </li>
                    
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item">
                                <a href="/profile" class="nav-link @(IsActive("/profile") ? "active" : "")">Profile</a>
                            </li>
                            <li class="nav-item">
                                <a href="/contracts" class="nav-link @(IsActive("/contracts") ? "active" : "")">My Contracts</a>
                            </li>
                            <li class="nav-item dropdown">
                                <span class="nav-link dropdown-toggle">
                                    Welcome, @context.User.Identity?.Name
                                </span>
                                <ul class="dropdown-menu">
                                    <li><button class="dropdown-item" @onclick="Logout">Logout</button></li>
                                </ul>
                            </li>
                        </Authorized>
                        <NotAuthorized>
                            <li class="nav-item">
                                <a href="/redirect-to-host-login" class="nav-link">Login</a>
                            </li>
                        </NotAuthorized>
                    </AuthorizeView>
                </ul>
            </nav>
        </div>
    </div>
</header>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Subscribe to authentication state changes
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authStateTask)
    {
        await InvokeAsync(() => StateHasChanged());
    }

    private async Task Logout()
    {
        try
        {
            await CookieService.DeleteCookieAsync("AuthToken");
            await CookieService.DeleteCookieAsync("RefreshToken");
            await CookieService.DeleteCookieAsync("UserId");
            await CookieService.DeleteCookieAsync("UserEmail");

            // Notify authentication state provider
            if (AuthStateProvider is CookieAuthenticationStateProvider customProvider)
            {
                customProvider.NotifyAuthenticationStateChanged();
            }

            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during logout: {ex.Message}");
            Nav.NavigateTo("/", forceLoad: true);
        }
    }

    bool IsActive(string path)
    {
        var currentPath = Nav.ToBaseRelativePath(Nav.Uri);
        if (string.IsNullOrEmpty(currentPath)) currentPath = "/";
        if (!currentPath.StartsWith("/")) currentPath = "/" + currentPath;
        
        return string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}