@using BLL.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Security.Claims

@inject NavigationManager Nav
@inject TokenAuthenticationStateProvider AuthProvider

<header class="header glass">
    <div class="container">
        <div class="header-inner">

            <NavLink class="brand" href="/">
                <div class="brand-badge">R</div>
                <div>
                    <div class="brand-title">Roomy <span style="color:var(--blue)">Customer</span></div>
                    <div class="brand-sub">Modern rental portal • FE-only</div>
                </div>
            </NavLink>

            <nav class="nav">

                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                    Home
                </NavLink>

                <NavLink class="nav-link" href="/rooms">
                    Rooms
                </NavLink>

                <NavLink class="nav-link" href="/my-room">
                    My Room
                </NavLink>

                <NavLink class="nav-link" href="/tickets">
                    Ticket Center
                </NavLink>

                <NavLink class="nav-link" href="/profile">
                    Profile
                </NavLink>

                <NavLink class="nav-link" href="/notifications">
                    Thông báo
                </NavLink>

                <AuthorizeView>
                    <Authorized>

                        <span style="font-weight:600;">
                            @context.User.FindFirst(ClaimTypes.Email)?.Value
                        </span>

                        <button class="btn-grad"
                                style="padding:10px 14px;border:none;cursor:pointer;"
                                @onclick="Logout">
                            Logout
                        </button>

                    </Authorized>

                    <NotAuthorized>

                        <NavLink class="btn-grad"
                                 href="/login"
                                 style="padding:10px 14px;">
                            Login
                        </NavLink>

                    </NotAuthorized>
                </AuthorizeView>

            </nav>

        </div>
    </div>
</header>

@code {

    private async Task Logout()
    {
        await AuthProvider.NotifyUserLogoutAsync();
        Nav.NavigateTo("/login");
    }

}