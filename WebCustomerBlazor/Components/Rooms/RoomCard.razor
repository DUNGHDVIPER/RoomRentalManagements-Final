@using BLL.DTOs.Room.Public
@inject NavigationManager Nav

<div class="card room-card"
     @onclick="@(()=>Nav.NavigateTo($"/rooms/{Room.Id}"))">

    <img class="room-img"
         src="@Room.Images.FirstOrDefault()?.Url" />

    <div class="room-body">

        <div class="room-title">
            @Room.Name
        </div>

        <div class="room-meta">

            <span class="meta-chip">
                📍 @Room.District
            </span>

            <span class="meta-chip">
                📐 @Room.Area m²
            </span>

            <span class="meta-chip">
                🕒 @Room.PostedAgo
            </span>

        </div>

        <div class="room-price">
            @Room.Price.ToString("N0") ₫ / month
        </div>

    </div>

</div>

@code {

    [Parameter]
    public RoomPublicDto Room { get; set; } = new();

}