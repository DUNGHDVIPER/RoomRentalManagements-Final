@page "/rooms"

@using BLL.DTOs.Room.Public
@using BLL.Services

@inject CustomerRoomService RoomService
@inject NavigationManager Nav

<div class="section">
	<div class="container">

		<h1 class="h1">Find Your Room</h1>

		<div class="card filter-card">

			<div class="filter-grid">

				<!-- SEARCH -->
				<div>
					<div class="label">Search</div>
					<input class="input"
						   placeholder="Room name..."
						   @bind="search" />
				</div>

				<!-- MAX PRICE -->
				<div>
					<div class="label">Max Price</div>
					<input class="input"
						   type="number"
						   @bind="maxPrice" />
				</div>

				<!-- MIN AREA -->
				<div>
					<div class="label">Min Area</div>
					<input class="input"
						   type="number"
						   @bind="minArea" />
				</div>

				<!-- BLOCK -->
				<div>
					<div class="label">Block</div>
					<select class="select" @bind="block">

						<option value="">All</option>

						@foreach (var b in blocks)
						{
							<option value="@b">@b</option>
						}

					</select>
				</div>

				<!-- FLOOR -->
				<div>
					<div class="label">Floor</div>
					<select class="select" @bind="floor">

						<option value="">All</option>

						@foreach (var f in floors)
						{
							<option value="@f">@f</option>
						}

					</select>
				</div>

				<!-- BUTTON -->
				<button class="btn-grad"
						@onclick="LoadRooms">
					Search
				</button>

			</div>
		</div>

		<hr class="hr" />

		@if (rooms == null)
		{
			<p class="muted">Loading rooms...</p>
		}
		else if (!rooms.Any())
		{
			<p class="muted">No rooms found</p>
		}
		else
		{
			<div class="room-grid">

				@foreach (var r in rooms)
				{
					<RoomCard Room="r" />
				}

			</div>
		}

	</div>
</div>

@code {

	List<RoomPublicDto>? rooms;

	List<string> blocks = new();
	List<string> floors = new();

	string? search;
	decimal? maxPrice;
	double? minArea;

	string? block;
	string? floor;

	protected override async Task OnInitializedAsync()
	{
		await LoadFilters();
		await LoadRooms();
	}

	async Task LoadFilters()
	{
		var filters = await RoomService.GetRoomFiltersAsync();

		blocks = filters.Blocks;
		floors = filters.Floors;
	}

	async Task LoadRooms()
	{
		rooms = await RoomService.GetRoomsAsync(
			search,
			maxPrice,
			minArea,
			block,
			floor);
	}

}