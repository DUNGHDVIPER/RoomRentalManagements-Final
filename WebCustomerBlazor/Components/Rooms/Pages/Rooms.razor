@page "/rooms"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider Auth

<div class="section">
    <div class="container">
        <div class="card glass p-22" style="max-width:900px;margin:0 auto;">
            <h2 class="h2">Rooms Page</h2>
            <p class="muted" style="margin-top:8px;">
                Đây là trang danh sách phòng. Sau khi login, thông tin tài khoản sẽ hiện ở đây.
            </p>

            <hr class="hr" />

            @if (isAuthenticated)
            {
                <div class="card glass p-16" style="border:1px solid #bbf7d0;">
                    <div style="font-size:18px;font-weight:700;">Login thành công rồi 🎉</div>
                    <div class="muted" style="margin-top:8px;">Email: <b>@userEmail</b></div>
                    <div class="muted">Role: <b>@userRole</b></div>
                </div>
            }
            else
            {
                <div class="card glass p-16" style="border:1px solid #fecaca;">
                    <div style="font-size:18px;font-weight:700;">Bạn chưa đăng nhập</div>
                    <div class="muted" style="margin-top:8px;">
                        Bạn vẫn có thể xem phòng, nhưng hãy đăng nhập để dùng đầy đủ chức năng.
                    </div>
                    <div style="margin-top:12px;">
                        <a class="btn-grad" href="/login">Đi tới Login</a>
                    </div>
                </div>
            }

            <hr class="hr" />

            <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;">
                <div class="card glass p-16">
                    <div style="font-weight:700;">Studio Quận 1</div>
                    <div class="muted" style="margin-top:8px;">Giá: 5.500.000 VNĐ</div>
                    <div class="muted">Nội thất cơ bản • 22m²</div>
                </div>

                <div class="card glass p-16">
                    <div style="font-weight:700;">Phòng có gác Bình Thạnh</div>
                    <div class="muted" style="margin-top:8px;">Giá: 4.200.000 VNĐ</div>
                    <div class="muted">Có máy lạnh • 18m²</div>
                </div>

                <div class="card glass p-16">
                    <div style="font-weight:700;">Căn hộ mini Thủ Đức</div>
                    <div class="muted" style="margin-top:8px;">Giá: 6.800.000 VNĐ</div>
                    <div class="muted">Full nội thất • 28m²</div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isAuthenticated;
    private string userEmail = "";
    private string userRole = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        userEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? "";
        userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
    }
}