
@using BLL.DTOs
@page "/my-room"
@using BLL.DTOs.Contract
@using BLL.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject AuthenticationStateProvider Auth
@inject IContractService ContractService

<div class="section">
    <div class="container">
        <div class="card glass p-22" style="max-width:1000px;margin:0 auto;">
            <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;">
                <div>
                    <h2 class="h2">My Contract</h2>
                    <p class="muted" style="margin-top:8px;">
                        Xem chi tiết hợp đồng và file hợp đồng đã được host tải lên để admin quản lý.
                    </p>
                </div>

                @if (contract is not null)
                {
                    <span class="chip">@contract.Status</span>
                }
            </div>

            @if (isLoading)
            {
                <div class="card glass p-16" style="margin-top:16px;">
                    Đang tải thông tin hợp đồng...
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert" style="margin-top:16px;">
                    @error
                </div>
            }
            else if (contract is null)
            {
                <div class="card glass p-16" style="margin-top:16px; border:1px solid #fde68a;">
                    <div style="font-weight:700;">Chưa có hợp đồng đang hiệu lực</div>
                    <div class="muted" style="margin-top:8px;">
                        Tài khoản này hiện chưa được gán hợp đồng active.
                    </div>
                </div>
            }
            else
            {
                <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:18px;">
                    <div class="card glass p-16">
                        <div class="muted">Contract Code</div>
                        <div style="font-weight:700; margin-top:6px;">@contract.ContractCode</div>
                    </div>
                    <div class="card glass p-16">
                        <div class="muted">Tenant</div>
                        <div style="font-weight:700; margin-top:6px;">@contract.TenantName</div>
                        <div class="muted small">@contract.TenantEmail</div>
                    </div>
                    <div class="card glass p-16">
                        <div class="muted">Room</div>
                        <div style="font-weight:700; margin-top:6px;">@contract.RoomCode</div>
                        <div class="muted small">@contract.RoomName</div>
                    </div>
                    <div class="card glass p-16">
                        <div class="muted">Period</div>
                        <div style="font-weight:700; margin-top:6px;">@contract.StartDate.ToString("dd/MM/yyyy")</div>
                        <div class="muted small">đến @contract.EndDate.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="card glass p-16">
                        <div class="muted">Rent</div>
                        <div style="font-weight:700; margin-top:6px;">@contract.Rent.ToString("N0") đ</div>
                    </div>
                    <div class="card glass p-16">
                        <div class="muted">Deposit</div>
                        <div style="font-weight:700; margin-top:6px;">@contract.Deposit.ToString("N0") đ</div>
                        <div class="muted small">@contract.DepositStatus</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(contract.Note))
                {
                    <div class="card glass p-16" style="margin-top:16px;">
                        <div style="font-weight:700;">Note</div>
                        <div class="muted" style="margin-top:8px; white-space:pre-wrap;">@contract.Note</div>
                    </div>
                }

                <div class="card glass p-22" style="margin-top:18px;">
                    <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;">
                        <div>
                            <div style="font-weight:700;font-size:18px;">Contract files</div>
                            <div class="muted">Admin và host có thể xem cùng các file này. Tenant có thể mở trực tiếp.</div>
                        </div>
                        <span class="muted">@contract.Attachments.Count file</span>
                    </div>

                    @if (contract.Attachments.Count == 0)
                    {
                        <div class="muted" style="margin-top:14px;">Chưa có file hợp đồng nào được tải lên.</div>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:16px;">
                            @foreach (var file in contract.Attachments)
                            {
                                <div class="card glass p-16">
                                    <div style="font-weight:700; word-break:break-word;">@file.FileName</div>
                                    <div class="muted small" style="margin-top:6px;">Uploaded: @file.UploadedAt.ToString("dd/MM/yyyy HH:mm")</div>

                                    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px;">
                                        <a class="btn-grad" href="@file.FileUrl" target="_blank">Open</a>
                                        <a class="btn-ghost" href="@file.FileUrl" download>Download</a>
                                    </div>

                                    @if (file.IsImage)
                                    {
                                        <img src="@file.FileUrl" alt="@file.FileName" style="width:100%;margin-top:14px;border-radius:12px;border:1px solid #e5e7eb;" />
                                    }
                                    else if (file.IsPdf)
                                    {
                                        <div style="margin-top:14px;">
                                            <iframe src="@file.FileUrl" style="width:100%;height:360px;border:1px solid #e5e7eb;border-radius:12px;"></iframe>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isLoading = true;
    private string? error;
    private TenantContractDetailsDto? contract;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            var user = state.User;

            if (!(user.Identity?.IsAuthenticated ?? false))
            {
                error = "Bạn chưa đăng nhập.";
                return;
            }

            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
            {
                error = "Không xác định được người dùng hiện tại.";
                return;
            }

            contract = await ContractService.GetActiveContractDetailsByUserIdAsync(userId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}