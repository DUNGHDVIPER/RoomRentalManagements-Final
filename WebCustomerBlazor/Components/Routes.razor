@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>

    <Router AppAssembly="@typeof(Program).Assembly">

        <Found Context="routeData">

            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@typeof(MainLayout)">

                <Authorizing>

                    <LayoutView Layout="@typeof(MainLayout)">
                        <div class="section">
                            <div class="container">
                                <div class="card glass p-22" style="max-width:720px;margin:40px auto;">
                                    <h3>Đang kiểm tra đăng nhập...</h3>
                                </div>
                            </div>
                        </div>
                    </LayoutView>

                </Authorizing>

                <NotAuthorized>

                    <LayoutView Layout="@typeof(MainLayout)">
                        <div class="section">
                            <div class="container">
                                <div class="card glass p-22" style="max-width:720px;margin:40px auto;">
                                    <h3>Bạn cần đăng nhập để truy cập trang này</h3>
                                    <p class="muted" style="margin-top:10px;">
                                        Hãy đăng nhập bằng tài khoản Customer hoặc Tenant.
                                    </p>
                                    <div style="margin-top:16px;">
                                        <a class="btn-grad" href="/login">Đi tới Login</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </LayoutView>

                </NotAuthorized>

            </AuthorizeRouteView>

        </Found>

        <NotFound>

            <LayoutView Layout="@typeof(MainLayout)">
                <div class="section">
                    <div class="container">
                        <div class="card glass p-22" style="max-width:720px;margin:40px auto;">
                            <h3>Page not found</h3>
                        </div>
                    </div>
                </div>
            </LayoutView>

        </NotFound>

    </Router>

</CascadingAuthenticationState>